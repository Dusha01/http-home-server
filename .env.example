# =============================================================================
# Home Server — пример переменных окружения
# Скопируйте в .env в корне или в server/.env и настройте под себя.
# См. server/.env.example для полного списка переменных бэкенда.
# =============================================================================
# Home Server — example environment variables
# Copy to .env in project root or server/.env and adjust.
# See server/.env.example for full list of backend variables.
# =============================================================================

# Запуск без интерактивного выбора: true = с токеном, false = без токена
# Run without prompt: true = with token auth, false = no auth
# AUTH_REQUIRED=true

# Путь к собранному фронтенду (для скрипта start.sh задаётся автоматически)
# Path to built frontend (set automatically by start.sh)
# STATIC_DIR=./frontend/build
