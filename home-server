#!/usr/bin/env bash
# home-server: dev-запуск API + Vite (см. scripts/run-cli.sh; нужны server/.venv и frontend/node_modules).

set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec "$ROOT/scripts/run-cli.sh" "$@"
