# =============================================================================
# Home Server — Backend / Сервер (server/)
# Скопируйте в .env: cp .env.example .env
# Copy to .env: cp .env.example .env
# =============================================================================

# ----- Режим аутентификации / Authentication mode -----
# true = доступ по токену, false = без токена (все в сети видят файлы)
# true = token required, false = no auth (everyone on network can access)
# Если не задано — при запуске будет вопрос в консоли.
# If not set — console prompt on startup.
# AUTH_REQUIRED=true

# ----- Режим релиза: раздача веб-интерфейса / Release: serve web UI -----
# Путь к папке со сборкой фронта (frontend/build). Если задан — API под /api, корень = SPA.
# Path to frontend build directory. If set — API under /api, root serves SPA.
# STATIC_DIR=../frontend/build

# ----- Сеть / Network -----
# Хост и порт сервера
# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ----- Режим отладки / Debug -----
# true = перезагрузка при изменении кода, подробные логи
# true = reload on code change, verbose logs
DEBUG=false

# ----- Язык консоли и подсказок / Console language -----
# ru | en
LANGUAGE=ru

# ----- Безопасность (production) / Security (production) -----
# Секретный ключ — смените в продакшене
# Secret key — change in production
SECRET_KEY=your-secret-key-change-in-production

# Срок действия токена в часах
# Token expiry in hours
TOKEN_EXPIRY_HOURS=24

# ----- CORS -----
# Разрешённые источники через запятую (по умолчанию *)
# Allowed origins, comma-separated (default *)
# CORS_ORIGINS=*

# ----- Файлы / Files -----
# Максимальный размер загружаемого файла (число или 100MB, 1GB)
# Max upload size (number in bytes or 100MB, 1GB)
MAX_FILE_SIZE=104857600

# Разрешения путей (по умолчанию storage в папке server)
# Paths (default: storage inside server folder)
# BASE_DIR=.
# STORAGE_DIR=./storage
# UPLOAD_DIR=./storage/uploads
